# REQUIRED: Mnemonic (24 words) of the wallet
WATCH_WALLET_MNEMONIC="label label label label label label label label label label label label label label label label label label label label label label label label label label"

# REQUIRED: Address of the jetton to be detected and sold automatically
JETTON_ADDRESS=""

# REQUIRED: Wallets for distributing the TONs after sale
WALLET_A="" # destination 80%
WALLET_B="" # destination 20%

# OPTIONAL: TON network settings
TON_RPC_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"
TON_API_KEY="API_KEY_HERE"

# OPTIONAL: Polling interval in milliseconds (default: 5000 = 5 seconds)
POLL_INTERVAL_MS=5000

# Development mode
NODE_ENV=development